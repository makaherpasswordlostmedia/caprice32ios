<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Caprice32ARMv7</string>
	<key>CFBundleIdentifier</key>
	<string>com.example.caprice32ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Caprice32</string>
	<key>CFBundleDisplayName</key>
	<string>Caprice32</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>4.6.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSignature</key>
	<string>????</string>

	<!-- Hard requirement for this port: 32-bit armv7 only, no arm64,
	     matching iPhone 4s - 5c / iPad 2 - 4 hardware that can still
	     run iOS 9.3. Do not add arm64 to Architectures or this becomes
	     a fat binary Xcode 9's toolchain can't produce anyway. -->
	<key>MinimumOSVersion</key>
	<string>9.3</string>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- No arm64 flag needed/available at this OS target; do not add
	     UIRequiredDeviceCapabilities "arm64" -->

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- SDL2's UIKit backend expects this exact delegate class name
	     unless SDL_MAIN_HANDLED / SDL_UIKitDelegate subclass wiring is
	     changed - see AppDelegate.mm for the (thin) subclass used here
	     to intercept document-open events before SDL takes over. -->
	<key>UIApplicationDelegateClassName</key>
	<string>Caprice32AppDelegate</string>

	<!-- UILaunchStoryboardName removed: this Linux-hosted Theos
	     cross-toolchain has no ibtool (part of Xcode) to compile
	     LaunchScreen.storyboard into the binary LaunchScreen.storyboardc
	     iOS actually requires at launch. Theos's RESOURCE_FILES just
	     copies the raw XML .storyboard file into the bundle as-is, and
	     UIKit crashes with an uncaught NSInvalidArgumentException while
	     trying to NSKeyedUnarchiver-decode that XML text as a compiled
	     NIB archive during -[UIApplication _run] startup - which is
	     exactly the crash this app was hitting on-device (SIGABRT via
	     objc_exception_throw inside UIKit's launch sequence, before
	     cap32_main() / any app code ever runs).
	     Use the pre-iOS-8 static launch image mechanism instead, which
	     needs no compilation step - just a plain PNG asset. -->
	<key>UILaunchImageFile</key>
	<string>LaunchImage</string>

	<!-- iPad's launch-image selection additionally consults
	     UILaunchImages for orientation/idiom-specific variants; since
	     this app is landscape-only (see UISupportedInterfaceOrientations
	     above) and iPad mini 1 is the target hardware in the crash
	     report, declare the landscape variant explicitly rather than
	     relying on UILaunchImageFile's plainer (and less iPad-reliable)
	     single-name lookup alone. -->
	<key>UILaunchImages</key>
	<array>
		<dict>
			<key>UILaunchImageMinimumOSVersion</key>
			<string>7.0</string>
			<key>UILaunchImageName</key>
			<string>LaunchImage</string>
			<key>UILaunchImageOrientation</key>
			<string>Landscape</string>
			<key>UILaunchImageSize</key>
			<string>{768, 1024}</string>
		</dict>
	</array>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- CPC screen is natively 4:3ish landscape; do not fight it with
	     portrait support -->

	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Let the emulator's own DSK/SNA/CDT/CPR files be opened from
	     Files.app / Mail / AirDrop directly into this app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Amstrad CPC Disk Image</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.caprice32.dsk</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.caprice32.dsk</string>
			<key>UTTypeDescription</key>
			<string>Amstrad CPC Disk Image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dsk</string>
					<string>sna</string>
					<string>cdt</string>
					<string>cpr</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
